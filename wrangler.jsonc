{
  "name": "horizon-of-oasis",
  "compatibility_date": "2026-10-01",
  // Redirects the old horizonofoasis.com address to resethoasis.com, then serves ./public.
  "main": "./src/index.js",
  // Static site: every file in ./public is served as-is by Workers static assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Attaches both domains on deploy. Each must be a zone in the same Cloudflare account.
  "routes": [
    { "pattern": "resethoasis.com", "custom_domain": true },
    { "pattern": "horizonofoasis.com", "custom_domain": true }
  ]
}
